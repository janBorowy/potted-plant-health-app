### Duplicate sensor name in series A is rejected
POST {{baseUrl}}/api/sensors
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "sensor-a1-{{tag}}",
  "seriesId": "{{seriesAId}}"
}

> {%
client.test("Duplicate sensor name rejected", function () {
    client.assert(response.status === 400 || response.status === 422, "Expected 400/422");
});
%}
