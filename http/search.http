@username = {{adminUsername}}
@password = {{adminPassword}}

### Create the three demo series and sensors, then print the runner command
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
    client.test("Admin login succeeds", function () {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.accessToken, "Expected an access token");
    });
    client.global.set("demoAuthToken", response.body.accessToken);
    client.global.set("demoTag", $random.hexadecimal(8));
%}

